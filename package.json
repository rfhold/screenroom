{
  "name": "screenroom",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "scripts": {
    "backend:up": "bash scripts/backend.sh up",
    "backend:wait": "bash scripts/backend.sh wait",
    "backend:status": "bash scripts/backend.sh status",
    "backend:down": "bash scripts/backend.sh down",
    "test:backend": "python3 scripts/backend-contract.py",
    "test:backend-lifecycle": "python3 scripts/backend-lifecycle-tests.py",
    "test:e2e": "bash scripts/e2e.sh",
    "check:client-boundary": "node scripts/check-client-boundary.mjs",
    "test:client-boundary": "node --test scripts/test-client-boundary.mjs",
    "check": "pnpm -r check",
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter @screenroom/web dev",
    "dev:website": "pnpm --filter @screenroom/website dev"
  }
}
